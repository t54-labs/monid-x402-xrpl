{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Monid XRPL gateway with a retained root disk and CloudFront VPC origin.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9.-]+"
    },
    "ReleaseKey": {
      "Type": "String",
      "AllowedPattern": "releases/[a-zA-Z0-9._/-]+"
    },
    "ReleaseSha256": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "SourceRevision": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{40}"
    },
    "AmiId": {
      "Type": "AWS::EC2::Image::Id"
    },
    "AvailabilityZone": {
      "Type": "AWS::EC2::AvailabilityZone::Name"
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "AllowedPattern": "pl-[a-f0-9]+"
    },
    "CloudFrontServiceSecurityGroupId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|sg-[a-f0-9]+)"
    },
    "ParameterPrefix": {
      "Type": "String",
      "Default": "/monid-x402-xrpl/runtime",
      "AllowedPattern": "(/[a-zA-Z0-9_.-]+)+",
      "Description": "Runtime parameter path; must match automation.json and the host configuration."
    },
    "ServiceName": {
      "Type": "String",
      "Default": "monid-x402-xrpl",
      "AllowedPattern": "[a-z][a-z0-9-]{2,39}",
      "Description": "Stable service name used for resource display names."
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.54.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}-vpc"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}-igw"
            }
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.54.1.0/24",
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}-subnet"
            }
          }
        ]
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}-routes"
            }
          }
        ]
      }
    },
    "DefaultRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "SubnetRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "OriginSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "CloudFront origin ingress only; no SSH",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "Fn::If": [
              "UseServiceSecurityGroup",
              {
                "IpProtocol": "tcp",
                "FromPort": 80,
                "ToPort": 80,
                "SourceSecurityGroupId": {
                  "Ref": "CloudFrontServiceSecurityGroupId"
                }
              },
              {
                "IpProtocol": "tcp",
                "FromPort": 80,
                "ToPort": 80,
                "SourcePrefixListId": {
                  "Ref": "CloudFrontPrefixListId"
                }
              }
            ]
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}-origin-sg"
            }
          }
        ]
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "RestrictRuntimeParameters",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DenyParameterValuesOutsideRuntime",
                  "Effect": "Deny",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                    "ssm:GetParameterHistory"
                  ],
                  "NotResource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${ParameterPrefix}/*"
                  }
                },
                {
                  "Sid": "DenyParameterPathsOutsideRuntime",
                  "Effect": "Deny",
                  "Action": "ssm:GetParametersByPath",
                  "NotResource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${ParameterPrefix}"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ReadRelease",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/${ReleaseKey}"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}-instance-role"
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t3.small",
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "DisableApiTermination": true,
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "HttpEndpoint": "enabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "OriginSecurityGroup"
              }
            ]
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\ninstall -d -m 0700 /opt/monid-release\ncd /opt/monid-release\naws s3 cp 's3://${ArtifactBucket}/${ReleaseKey}' release.tar.gz --region '${AWS::Region}' --only-show-errors\nprintf '%s  release.tar.gz\\n' '${ReleaseSha256}' | sha256sum --check -\ntar -xzf release.tar.gz\nbash deploy/aws/bootstrap.sh\n"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "SourceRevision",
            "Value": {
              "Ref": "SourceRevision"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}"
            }
          }
        ]
      },
      "DependsOn": [
        "DefaultRoute",
        "SubnetRoute"
      ],
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${Instance}"
          },
          "Name": {
            "Fn::Sub": "${AWS::StackName}-origin"
          },
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only",
          "OriginSSLProtocols": [
            "TLSv1.2"
          ],
          "IpAddressType": "ipv4"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "migration-standby"
          }
        ]
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "${ServiceName} gateway"
          },
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "gateway",
              "DomainName": {
                "Fn::GetAtt": [
                  "Instance",
                  "PrivateDnsName"
                ]
              },
              "ConnectionAttempts": 1,
              "ConnectionTimeout": 5,
              "ResponseCompletionTimeout": 120,
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "VpcOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 120,
                "OriginKeepaliveTimeout": 5
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "gateway",
            "ViewerProtocolPolicy": "https-only",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "PATCH",
              "POST",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
            "Compress": true
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 414,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 416,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 501,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ],
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "monid-x402-xrpl"
          },
          {
            "Key": "Stage",
            "Value": "standby"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ServiceName}-cdn"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      }
    },
    "OriginSecurityGroupId": {
      "Value": {
        "Ref": "OriginSecurityGroup"
      }
    },
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "PublicUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "VpcOriginId": {
      "Value": {
        "Fn::GetAtt": [
          "VpcOrigin",
          "Id"
        ]
      }
    }
  },
  "Conditions": {
    "UseServiceSecurityGroup": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CloudFrontServiceSecurityGroupId"
            },
            ""
          ]
        }
      ]
    }
  }
}
