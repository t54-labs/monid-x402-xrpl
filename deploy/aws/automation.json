{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GitHub Actions OIDC, ECR images, and EC2 runtime configuration access for Monid.",
  "Parameters": {
    "ServiceName": {
      "Type": "String",
      "Default": "monid-x402-xrpl",
      "AllowedPattern": "[a-z][a-z0-9-]{2,39}"
    },
    "GitHubProviderArn": {
      "Type": "String"
    },
    "GitHubSubject": {
      "Type": "String",
      "AllowedPattern": "repo:.+:environment:aws"
    },
    "InstanceId": {
      "Type": "AWS::EC2::Instance::Id"
    },
    "InstanceRoleName": {
      "Type": "String"
    },
    "ParameterPrefix": {
      "Type": "String",
      "Default": "/monid-x402-xrpl/runtime",
      "AllowedPattern": "/[a-zA-Z0-9/_-]+"
    }
  },
  "Resources": {
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": {
          "Ref": "ServiceName"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ServiceName"
            }
          }
        ]
      }
    },
    "GitHubRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ServiceName}-github"
        },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Ref": "GitHubSubject"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BuildAndDeployGateway",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:CompleteLayerUpload",
                    "ecr:InitiateLayerUpload",
                    "ecr:PutImage",
                    "ecr:UploadLayerPart",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:DescribeImages"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Repository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${InstanceId}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}::document/AWS-RunShellScript"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetCommandInvocation",
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ServiceName"
            }
          }
        ]
      }
    },
    "InstanceRuntimePolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${ServiceName}-runtime"
        },
        "Roles": [
          {
            "Ref": "InstanceRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ecr:GetAuthorizationToken",
              "Resource": "*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "ecr:BatchGetImage",
                "ecr:GetDownloadUrlForLayer",
                "ecr:BatchCheckLayerAvailability"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Repository",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": "ssm:GetParametersByPath",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${ParameterPrefix}"
              }
            },
            {
              "Effect": "Allow",
              "Action": "ssm:GetParameters",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${ParameterPrefix}/*"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "GitHubRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "GitHubRole",
          "Arn"
        ]
      }
    },
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "ParameterPrefix": {
      "Value": {
        "Ref": "ParameterPrefix"
      }
    }
  }
}
