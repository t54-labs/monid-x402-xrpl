# Cloud Build uploads happen BEFORE Docker applies .dockerignore.
# Keep this allowlist independent of .gitignore and never include .env or data/.
**
!.gcloudignore
!.dockerignore
!deploy/
deploy/*
!deploy/examples/
deploy/examples/*
!deploy/examples/cloudbuild.yaml
!Dockerfile
!pyproject.toml
!uv.lock
!README.md
!THIRD_PARTY_NOTICES.md
!gateway/
gateway/*
!gateway/*.py
!gateway/**/*.py
!scripts/
scripts/*
!scripts/*.py
!scripts/**/*.py
**/.env*
**/data/**
**/*.pem
**/*.key
**/*.log
**/*.sqlite*
**/*.db
**/*.bak
**/__pycache__/
**/*.pyc
