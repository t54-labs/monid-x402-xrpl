# Copy to .env. Paid routes stay closed (503) until every required value is set;
# GET /health lists what is missing.

# --- Brand ------------------------------------------------------------------
# Shown as the merchant name in directories (upstream name + function, like
# "Heurist Inference Router").
GATEWAY_BRAND_NAME=Monid Tool Router
# GATEWAY_DESCRIPTION=Tool Router — Powered by Monid. ...
# Strip the upstream platform's name from public tool text (only for a white-label brand).
HIDE_UPSTREAM_BRAND=false
UPSTREAM_BRAND_TERMS=Monid

PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PATH=data/gateway.sqlite3
CATALOG_SNAPSHOT_PATH=data/catalog.json

# --- Upstream ---------------------------------------------------------------
MONID_API_BASE_URL=https://api.monid.ai
# Workspace API key (app.monid.ai/access/api-keys). Never commit it.
MONID_API_KEY=
# Stop taking new paid requests when the prepaid balance falls below this (USD).
MONID_MIN_BALANCE_USD=5

# Cumulative lifetime allocation, integer micro-USD. Zero/absent policy denies execution.
# No automatic reset or refund; see docs/spend-safety.md before setting any values.
MONID_SPEND_BUDGET_MICROS=0
MONID_SPEND_BUDGET_ID=
MONID_SPEND_ACCOUNT_ID=
MONID_TOOL_POLICIES_PATH=

# --- x402 on XRPL (RLUSD only) ---------------------------------------------
# xrpl:1 = testnet, xrpl:0 = mainnet. Issuer and facilitator must match the network.
X402_XRPL_NETWORK=xrpl:1
X402_XRPL_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
X402_XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
# Mainnet:
# X402_XRPL_NETWORK=xrpl:0
# X402_XRPL_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De
# X402_XRPL_FACILITATOR_URL=https://xrpl-facilitator-mainnet.t54.ai
# Receiving address (not applied for yet). Needs an RLUSD trust line.
X402_XRPL_PAYTO_ADDRESS=
# t54 facilitator SourceTag; XRPL AI Hub only indexes payments carrying a registered tag.
X402_SOURCE_TAG=804681468

# --- Pricing ----------------------------------------------------------------
# Upstream USD cost -> RLUSD 1:1, times (1 + markup), rounded up to the quantum.
PRICE_MARKUP=0
PRICE_QUANTUM_RLUSD=0.0001
MIN_PRICE_RLUSD=0.001
DEFAULT_RESULT_UNITS=10
DEFAULT_METERED_UNITS=10

# --- Catalog ----------------------------------------------------------------
CATALOG_REFRESH_SECONDS=3600
CATALOG_PAGE_SIZE=200
# Shared-state and time-billed tools stay off until per-buyer ownership exists.
EXCLUDED_PROVIDERS=agentmail,agentline,saperly,smolmachine,sfs,recall,x402.browserbase.com
EXCLUDED_ENDPOINTS=blockrun.ai#/api/v1/phone/*,blockrun.ai#/api/v1/voice/*,tinyfish#/browser-sessions/*,tinyfish#/browser-profiles/*

# --- Runs -------------------------------------------------------------------
RUN_WAIT_SECONDS=0
REQUEST_DEADLINE_SECONDS=100
MAX_CONCURRENT_RUNS=32
